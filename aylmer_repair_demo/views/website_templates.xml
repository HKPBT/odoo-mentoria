<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="website_demo_page" name="Aylmer Repair Demo Page">
        <t t-call="website.layout" no_header="True" no_footer="True">
            <t t-set="additional_title" t-value="'Aylmer Repair | Démonstration Odoo'"/>
            <t t-set="website_meta_description">Location, vente de pièces et service en atelier Aylmer Repair. Démonstration Odoo.</t>
            <div id="wrap" class="oe_structure">
                <div id="aylmer-demo-root" class="aylmer-demo">
<div class="demo-ribbon"><span class="pulse"></span> Catalogue, ventes et locations gérés dans Odoo <span class="ribbon-right">Propulsé par Odoo <b>↗</b></span></div>
  <header class="site-header">
    <a class="brand" href="#accueil" aria-label="Aylmer Repair, accueil"><img src="https://reparationaylmer.com/wp-content/uploads/2023/03/Aylmer-Repair-logo.png" alt="Aylmer Repair"/><span class="brand-demo">EN DÉMO</span></a>
    <button class="menu-toggle" aria-expanded="false" aria-controls="main-nav" aria-label="Ouvrir le menu">☰</button>
    <nav id="main-nav" aria-label="Navigation principale">
      <a href="#location">Location</a><a href="#atelier">Atelier</a><a href="/shop">Boutique</a><a href="#parcours">La démo Odoo</a>
    </nav>
    <div class="header-actions"><a class="phone" href="tel:+18196848446">819 684-8446</a><a class="button button-dark button-small" href="#contact">Parlons de votre projet <span>↗</span></a></div>
  </header>

  
    <section class="hero" id="accueil">
      <div class="hero-copy">
        <div class="eyebrow"><span class="eyebrow-line"></span> Luskville · Depuis 1976</div>
        <h1>Le bon équipement.<br/>Le <em>bon service.</em><br/>Tout simplement.</h1>
        <p>Location, pièces et réparations de petits moteurs : une équipe de proximité qui connaît votre terrain et votre métier.</p>
        <div class="hero-buttons"><a href="#location" class="button button-dark">Trouver une location <span>↗</span></a><a href="#atelier" class="text-link">Faire réparer mon équipement <span>→</span></a></div>
        <div class="hero-proof"><div class="proof-avatars"><span>AR</span><span>✳</span><span>76</span></div><p><b>Une équipe d’ici.</b><br/>Au service de l’Outaouais depuis 1976.</p></div>
      </div>
      <div class="hero-image" role="img" aria-label="Travail d’entretien sur de l’équipement extérieur">
        <div class="image-label"><span class="label-icon">✳</span><div><small>À VOTRE SERVICE</small><b>Du premier appel au retour en piste.</b></div><span class="label-arrow">↗</span></div>
        <div class="hero-tag"><b>50 ans</b><span>d’expertise<br/>sur le terrain</span></div>
      </div>
      <div class="hero-bottom"><span>VENTE <i>·</i> LOCATION <i>·</i> ATELIER</span><span>45°31' N — LUSKVILLE, QUÉBEC</span></div>
    </section>

    <section class="intro section-pad" id="services">
      <div class="section-kicker">UN PARTENAIRE POUR CHAQUE SAISON <span>01 / 04</span></div>
      <div class="intro-grid"><h2>Votre journée<br/>ne s’arrête pas.<br/><em>Nous non plus.</em></h2><div class="intro-body"><p>Besoin d’un outil pour le week-end, d’une pièce rare ou d’un mécanicien qui connaît les petits moteurs? On vous aide à repartir du bon pied.</p><a class="text-link" href="#contact">Découvrez nos services <span>→</span></a></div></div>
      <div class="service-cards">
        <a class="service-card card-rental" href="#location"><span class="card-number">01 / LOCATION</span><div class="service-card-bottom"><span class="service-icon">↗</span><div><h3>Prêt pour<br/>le prochain projet?</h3><p>Le bon équipement, au bon moment.</p></div><span class="circle-arrow">↗</span></div></a>
        <a class="service-card card-workshop" href="#atelier"><span class="card-number">02 / ATELIER</span><div class="service-card-bottom"><span class="service-icon">✳</span><div><h3>On lui donne<br/>une deuxième vie.</h3><p>Diagnostic clair. Réparation soignée.</p></div><span class="circle-arrow">↗</span></div></a>
        <a class="service-card card-parts" href="/shop"><span class="card-number">03 / PIÈCES &amp; VENTE</span><div class="service-card-bottom"><span class="service-icon">⌁</span><div><h3>La bonne pièce<br/>change tout.</h3><p>Du conseil et des pièces fiables.</p></div><span class="circle-arrow">↗</span></div></a>
      </div>
    </section>

    <section class="rental-section section-pad" id="location">
      <div class="section-kicker">LOCATION D’ÉQUIPEMENT <span>CATALOGUE ODOO</span></div>
      <div class="section-heading"><div><h2>Il vous faut un coup<br/>de <em>main?</em></h2><p>Choisissez une machine, puis sélectionnez les dates sur sa fiche de location.</p></div><a href="/shop" class="text-link">Voir tout l’équipement <span>→</span></a></div>
      <div class="product-cards rental-products">
        <t t-foreach="rental_products" t-as="product">
          <article class="catalog-product-card">
            <a class="catalog-product-image" t-att-href="product.website_url" t-att-aria-label="product.name">
              <img t-if="product.image_512" t-att-src="'/web/image/product.template/%s/image_512' % product.id" t-att-alt="product.name" loading="lazy"/>
              <span t-else="" class="catalog-image-placeholder">AYLMER REPAIR</span>
              <span class="shop-badge">LOCATION</span>
            </a>
            <div class="catalog-product-info"><small>DISPONIBLE À LA RÉSERVATION</small><h3 t-field="product.name"/><a class="text-link" t-att-href="product.website_url">Choisir les dates et réserver <span>→</span></a></div>
          </article>
        </t>
        <div t-if="not rental_products" class="catalog-empty"><b>Les locations publiées apparaîtront ici.</b><span>Créez une fiche dans Odoo, activez « Location » et publiez-la sur le site.</span><a class="button button-dark" href="/shop">Voir la boutique Odoo <span>↗</span></a></div>
      </div>
      <div class="native-flow-note">Les tarifs, les dates et les réservations sont traités sur la fiche produit et dans l’application Location d’Odoo.</div>
      <div class="rental-foot"><span>Matériel entretenu par notre atelier</span><span>Consignes de départ et retour incluses</span><span>Équipe locale, conseils pratiques</span></div>
    </section>

    <section class="workshop-section section-pad" id="atelier">
      <div class="workshop-image"><div class="workshop-stamp">AYLMER<br/>REPAIR<br/><small>EST. 1976</small></div><div class="workshop-caption"><span>01—02</span><b>Un atelier qui<br/>connaît la mécanique.</b><span>ENTRETIEN · DIAGNOSTIC · RÉPARATION</span></div></div>
      <div class="workshop-copy"><div class="section-kicker">SERVICE EN ATELIER <span>PRISE EN CHARGE</span></div><h2>On trouve<br/>la cause.<br/><em>On règle ça.</em></h2><p>Petits moteurs, équipement de jardin, moteurs hors-bord et bien plus. On vous explique ce qui se passe avant de commencer les travaux.</p>
        <div class="service-checks"><span>✓ Moteurs 2 et 4 temps</span><span>✓ Diagnostic &amp; estimation</span><span>✓ Tuyaux hydrauliques</span><span>✓ Hivernisation de bateau</span></div>
        <a t-if="appointment_url" class="button button-dark" t-att-href="appointment_url">Prendre rendez-vous <span>↗</span></a>
        <a t-else="" class="button button-dark" href="/contactus">Demander un rendez-vous <span>↗</span></a>
        <a class="text-link repair-request-link" href="/contactus">Demander une réparation <span>→</span></a>
      </div>
    </section>

    <section class="demo-section section-pad" id="parcours">
      <div class="demo-section-top"><div><div class="section-kicker">UN MÉTIER. DES FLUX CONNECTÉS. <span>02 / 04</span></div><h2>Voyez le travail<br/><em>avancer.</em></h2></div><p>Trois situations du quotidien. Un même fil conducteur : chaque étape, chaque pièce et chaque décision restent liées.</p></div>
      <div class="scenario-tabs" role="tablist" aria-label="Parcours de démonstration"><button class="scenario-tab active" role="tab" aria-selected="true" data-tab="rental">01 <span>Location</span></button><button class="scenario-tab" role="tab" aria-selected="false" data-tab="special">02 <span>Commande spéciale</span></button><button class="scenario-tab" role="tab" aria-selected="false" data-tab="repair">03 <span>Atelier</span></button></div>
      <div class="scenario-panel" id="scenario-panel" role="tabpanel">
        <div class="scenario-details"><div class="scenario-label"><span class="scenario-status"></span><span id="scenario-overline">PARC DE LOCATION · UNITÉ #LOC-014</span></div><h3 id="scenario-title">De la réservation<br/>au retour en atelier.</h3><p id="scenario-desc">Une unité, une période, un historique clair. La disponibilité suit l’équipement du départ jusqu’à son inspection de retour.</p><div class="scenario-actions" id="scenario-actions"></div><div class="scenario-coverage"><span>COUVERTURE VISÉE</span><b id="scenario-level">L1–L2 · Standard &amp; paramétrage</b></div></div>
        <div class="flow-board"><div class="flow-board-top"><div class="window-dots"><i></i><i></i><i></i></div><span>AYLMER REPAIR <b>/</b> OPERATIONS</span><span class="live-indicator"><i></i> DEMO</span></div><div class="flow-title"><span id="flow-eyebrow">CYCLE DE LOCATION</span><b id="flow-title">Motoculteur · LOC-014</b></div><div class="flow-steps" id="flow-steps"></div><div class="flow-bottom"><span id="flow-note">Historique de l’unité conservé à chaque étape.</span><button id="advance-flow">Faire avancer le scénario <b>→</b></button></div></div>
      </div>
      <div class="flow-legend"><span><i class="legend-dot done"></i> Étape enregistrée</span><span><i class="legend-dot current"></i> Étape courante</span><span><i class="legend-dot pending"></i> À venir</span><span class="flow-legend-right">Parcours illustratif · démonstration conceptuelle</span></div>
    </section>

    <section class="shop-section section-pad" id="boutique">
      <div class="shop-top"><div><div class="section-kicker">ÉQUIPEMENT &amp; PIÈCES <span>03 / 04</span></div><h2>Du bon matériel.<br/><em>De bons conseils.</em></h2></div><p>Une sélection de marques et de pièces pour vous aider à faire le travail comme il faut.</p></div>
      <div class="product-cards sale-products">
        <t t-foreach="sale_products" t-as="product">
          <article class="catalog-product-card">
            <a class="catalog-product-image" t-att-href="product.website_url" t-att-aria-label="product.name">
              <img t-if="product.image_512" t-att-src="'/web/image/product.template/%s/image_512' % product.id" t-att-alt="product.name" loading="lazy"/>
              <span t-else="" class="catalog-image-placeholder">AYLMER REPAIR</span>
              <span class="shop-badge">ÉQUIPEMENT &amp; PIÈCES</span>
            </a>
            <div class="catalog-product-info"><small>PRODUIT PUBLIÉ DANS ODOO</small><h3 t-field="product.name"/><a class="text-link" t-att-href="product.website_url">Voir le produit <span>→</span></a></div>
          </article>
        </t>
        <div t-if="not sale_products" class="catalog-empty"><b>Les produits publiés apparaîtront ici.</b><span>Créez vos produits dans Odoo, puis activez leur publication sur le site.</span><a class="button button-dark" href="/shop">Ouvrir la boutique Odoo <span>↗</span></a></div>
      </div>
      <div class="shop-note"><span>Catalogue complet</span><b>Produits, prix, panier, paiement et commandes utilisent les fonctions eCommerce d’Odoo.</b><a href="/shop" class="text-link">Magasiner dans la boutique <span>→</span></a></div>
    </section>

    <section class="connected-section section-pad">
      <div class="connected-copy"><div class="section-kicker">VOTRE SITE. VOS OPÉRATIONS. <span>04 / 04</span></div><h2>En ligne comme<br/><em>en magasin.</em></h2><p>Un seul catalogue Odoo pour les produits à vendre et à louer. Les commandes, les réservations et les disponibilités suivent les réglages de votre base Odoo.</p><a href="/shop" class="text-link">Ouvrir la boutique <span>→</span></a></div>
      <div class="integration-card"><div class="integration-head"><span>FLUX DE LA BOUTIQUE</span><span class="integration-status"><i></i> ODOO</span></div><div class="integration-node current-node"><div class="node-logo odoo-mark">o</div><div><small>CATALOGUE</small><b>Produits Odoo</b><span>Vente · location · publication</span></div><span class="node-badge">ACTIF</span></div><div class="integration-link"><div class="link-line"><i></i><i></i><i></i></div><div class="sync-label">Flux natifs Odoo</div><div class="sync-items"><span>Panier</span><span>Commandes</span><span>Réservations</span></div></div><div class="integration-node"><div class="node-logo shopify-mark">✓</div><div><small>SUIVI DES OPÉRATIONS</small><b>Back-office Odoo</b><span>Ventes · stock · location · atelier</span></div><span class="node-badge proposed">CONNECTÉ</span></div><p class="integration-disclaimer">Les rendez-vous et demandes de réparation nécessitent la configuration de leurs pages et équipes dans les applications Odoo correspondantes.</p></div>
    </section>

    <section class="contact-section section-pad" id="contact">
      <div class="contact-graphic"><div class="contact-orbit orbit-a"></div><div class="contact-orbit orbit-b"></div><div class="contact-star">✳</div><span class="contact-coordinate">45°31' N<br/>75°53' O</span></div>
      <div class="contact-content"><div class="section-kicker">ON EST LÀ POUR VOUS <span>LUSKVILLE, QC</span></div><h2>On s’occupe<br/>de <em>ça.</em></h2><p>Décrivez-nous votre projet. Une vraie personne de notre équipe vous répondra.</p><div class="contact-buttons"><a href="tel:+18196848446" class="button button-orange">Appelez le 819 684-8446 <span>↗</span></a><a class="text-link contact-message" href="/contactus">Contacter notre équipe <span>→</span></a></div><div class="hours"><div><b>NOUS JOINDRE</b><span>2930, route 148, Luskville, QC</span><span>Lundi–vendredi 8 h–17 h · Samedi 8 h–13 h</span></div><div><b>EN LIGNE</b><span>Boutique Aylmer Repair</span><span>Pièces, équipements et promotions</span></div></div></div>
    </section>
  

  <footer class="site-footer"><a href="#accueil" class="footer-brand"><img src="https://reparationaylmer.com/wp-content/uploads/2023/03/Aylmer-Repair-logo.png" alt="Aylmer Repair"/></a><div class="footer-tagline">Une entreprise familiale.<br/>Depuis 1976.</div><div class="footer-links"><a href="#location">Location</a><a href="/contactus">Réparations</a><a href="/shop">Pièces &amp; équipements</a><a href="#contact">Contact</a></div><div class="footer-meta"><span>© 2026 Aylmer Repair · Boutique Odoo</span><span>Catalogue et commandes gérés dans Odoo</span></div></footer>
